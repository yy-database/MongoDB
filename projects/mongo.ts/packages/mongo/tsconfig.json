{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022"],
        "types": ["node"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "declaration": true,
        "declarationMap": false,
        "sourceMap": false,
        "skipLibCheck": true,
        "verbatimModuleSyntax": false
    },
    "include": ["src"]
}
