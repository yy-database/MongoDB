{
    "name": "@yydb/mongodb",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "TypeScript acceptance surface and minimal shell for the Rust MongoDB primitives",
    "license": "MPL-2.0",
    "homepage": "https://github.com/yy-database/MongoDB#readme",
    "bugs": {
        "url": "https://github.com/yy-database/MongoDB/issues"
    },
    "keywords": [
        "mongodb",
        "database",
        "wire-protocol",
        "napi",
        "yydb"
    ],
    "bin": {
        "yydb-mongo": "bin/mongo.mjs",
        "yydb-mongod": "bin/serve.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "types": "dist/index.d.ts",
    "files": [
        "bin",
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "node tests/run.mjs"
    },
    "optionalDependencies": {
        "@yydb/mongodb-darwin-arm64": "0.0.1",
        "@yydb/mongodb-darwin-x64": "0.0.1",
        "@yydb/mongodb-linux-x64": "0.0.1",
        "@yydb/mongodb-unknown-wasm32": "0.0.1",
        "@yydb/mongodb-win32-x64": "0.0.1"
    },
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/MongoDB.git",
        "directory": "projects/mongo.ts/packages/mongo"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    }
}
