{
    "name": "@yydb/mongo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "TypeScript acceptance surface and minimal shell for the Rust MongoDB primitives",
    "license": "MPL-2.0",
    "bin": {
        "yydb-mongo": "bin/mongo.mjs",
        "yydb-mongod": "bin/serve.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "types": "dist/index.d.ts",
    "files": [
        "bin",
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "node tests/run.mjs"
    },
    "optionalDependencies": {
        "@yydb/mongo-darwin-arm64": "0.0.0",
        "@yydb/mongo-darwin-x64": "0.0.0",
        "@yydb/mongo-linux-x64": "0.0.0",
        "@yydb/mongo-unknown-wasm32": "0.0.0",
        "@yydb/mongo-win32-x64": "0.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    }
}
