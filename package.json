{
    "name": "mongo-workspace",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "check": "cargo +nightly-2026-07-20 check --manifest-path projects/mongo.rs/Cargo.toml --workspace",
        "build:napi": "node scripts/build-napi.mjs",
        "build:pyo3": "node scripts/build-pyo3.mjs",
        "build:ts": "tsc -p projects/mongo.ts/packages/mongo/tsconfig.json",
        "build": "npm run build:napi && npm run build:pyo3 && npm run build:ts",
        "gen:bson-cases": "node scripts/gen-bson-cases.mjs",
        "test:rust": "cargo +nightly-2026-07-20 test --manifest-path projects/mongo.rs/Cargo.toml --release --workspace",
        "test:ts": "node projects/mongo.ts/packages/mongo/tests/run.mjs",
        "test:py": "python projects/mongo.py/packages/mongo/tests/run.py",
        "test:server": "node projects/mongo.ts/packages/mongo/tests/server.mjs",
        "test:server:py": "python projects/mongo.py/packages/mongo/tests/server_e2e.py",
        "test:compat": "npm run test:server && npm run test:server:py",
        "gate:test-count": "node scripts/gate-test-count.mjs",
        "corpus": "node scripts/diff-corpus.mjs",
        "gate:corpus": "node scripts/diff-corpus.mjs --check",
        "gate:install-ts": "node scripts/gate-install-ts.mjs",
        "gate:install-py": "node scripts/gate-install-py.mjs",
        "gate:release-metadata": "node scripts/gate-release-metadata.mjs",
        "test": "npm run test:rust && npm run test:ts && npm run test:py && npm run gate:test-count"
    },
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.10",
        "@types/node": "^22.15.0",
        "mongodb": "^6.12.0",
        "typescript": "^5.9.2"
    }
}
