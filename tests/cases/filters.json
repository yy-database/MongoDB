                { "op": "find", "collection": "items", "filter": { "n": { "$eq": 2 } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "2" } }
            ]
        },
