{
    "version": 1,
    "cases": [
        {
            "id": "update.set_one",
            "surface": "update",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": "a" }, { "_id": 2, "v": "b" }] },
                { "op": "update", "collection": "items", "updates": [{ "q": { "_id": 1 }, "u": { "$set": { "v": "changed" } } }], "as": "r1" },
                { "op": "find", "collection": "items", "filter": { "_id": 1 }, "as": "r2" }
            ],
            "checks": [
                { "at": "/r1/ok", "equals": { "$numberDouble": "1.0" } },
                { "at": "/r1/n", "equals": { "$numberInt": "1" } },
                { "at": "/r1/nModified", "equals": { "$numberInt": "1" } },
                { "at": "/r2/cursor/firstBatch/0/v", "equals": "changed" }
            ]
        },
        {
