        {
            "id": "update.partial_failure_keeps_writes",
            "surface": "error",
            "source": "oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-06, a multi update that applies the first document and fails on the second keeps the applied write, reports n 0 and nModified 0 with one writeErrors entry, and aborts the remaining specs",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": {} }, { "_id": 2, "a": [1, 2] }] },
                { "op": "update", "collection": "items", "updates": [{ "q": {}, "u": { "$set": { "a.c": 5 } }, "multi": true }, { "q": { "_id": 2 }, "u": { "$set": { "b": 9 } } }], "as": "r" },
