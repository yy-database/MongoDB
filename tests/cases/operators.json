{
    "version": 1,
    "cases": [
        {
            "id": "op.and.two_clauses",
            "surface": "query",
            "source": "MongoDB manual, $and / Syntax: \"$and performs a logical AND operation on an array of one or more expressions\" (https://www.mongodb.com/docs/manual/reference/operator/query/and/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "score": 10 }, { "_id": 2, "score": 20 }, { "_id": 3, "score": 30 }] },
                { "op": "find", "collection": "items", "filter": { "$and": [{ "score": { "$gte": 20 } }, { "score": { "$lt": 30 } }] }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "2" } }
            ]
        },
        {
            "id": "op.and.nested_or",
            "surface": "query",
            "source": "MongoDB manual, $and / Syntax and $or / Syntax (https://www.mongodb.com/docs/manual/reference/operator/query/or/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "score": 10 }, { "_id": 2, "score": 20 }, { "_id": 3, "score": 30 }, { "_id": 4, "score": 40 }] },
                { "op": "find", "collection": "items", "filter": { "$and": [{ "$or": [{ "score": 10 }, { "score": 40 }] }, { "score": { "$gte": 20 } }] }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "4" } }
            ]
        },
        {
            "id": "op.or.two_clauses",
            "surface": "query",
            "source": "MongoDB manual, $or / Syntax: \"$or performs a logical OR operation on an array of one or more expressions and selects the documents that satisfy at least one of the expressions\" (https://www.mongodb.com/docs/manual/reference/operator/query/or/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "score": 10 }, { "_id": 2, "score": 20 }, { "_id": 3, "score": 30 }] },
                { "op": "find", "collection": "items", "filter": { "$or": [{ "score": 10 }, { "score": 30 }] }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.or.single_clause",
            "surface": "query",
            "source": "MongoDB manual, $or / Behavior: \"Using $or with a single clause has the same effect as omitting the $or operator\" (https://www.mongodb.com/docs/manual/reference/operator/query/or/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "score": 10 }, { "_id": 2, "score": 20 }] },
                { "op": "find", "collection": "items", "filter": { "$or": [{ "score": 20 }] }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "2" } }
            ]
        },
        {
            "id": "op.nor.missing_field",
            "surface": "query",
            "source": "MongoDB manual, $nor / Behavior: \"$nor selects documents that fail all the query clauses ... including those documents that do not contain these field(s)\" (https://www.mongodb.com/docs/manual/reference/operator/query/nor/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": 1 }, { "_id": 2, "a": 2 }, { "_id": 3 }] },
                { "op": "find", "collection": "items", "filter": { "$nor": [{ "a": 1 }, { "a": 2 }] }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "3" } }
            ]
        },
        {
            "id": "op.and.empty_array_rejected",
            "surface": "error",
            "source": "No source: https://www.mongodb.com/docs/manual/reference/operator/query/and/ documents only arrays of one or more expressions, so an empty $and is refused rather than guessed",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$and": [] }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "$and with an empty array is not defined by the MongoDB manual; refusing to guess (operation: find, fieldIndex: 0)" }
            ]
        },
        {
            "id": "op.or.empty_array_rejected",
            "surface": "error",
            "source": "No source: https://www.mongodb.com/docs/manual/reference/operator/query/or/ documents only arrays of one or more expressions, so an empty $or is refused rather than guessed",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$or": [] }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "$or with an empty array is not defined by the MongoDB manual; refusing to guess (operation: find, fieldIndex: 0)" }
            ]
        },
        {
            "id": "op.nor.empty_array_rejected",
            "surface": "error",
            "source": "No source: https://www.mongodb.com/docs/manual/reference/operator/query/nor/ documents only arrays of one or more query predicates, so an empty $nor is refused rather than guessed",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$nor": [] }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "$nor with an empty array is not defined by the MongoDB manual; refusing to guess (operation: find, fieldIndex: 0)" }
            ]
        },
        {
            "id": "op.nor.not_an_array",
            "surface": "error",
            "source": "MongoDB manual, $nor / Syntax: the argument is an array of query predicates (https://www.mongodb.com/docs/manual/reference/operator/query/nor/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$nor": { "a": 1 } }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "$nor requires an array of filter documents (operation: find, fieldIndex: 0)" }
            ]
        },
        {
            "id": "op.and.member_not_document",
            "surface": "error",
            "source": "MongoDB manual, $and / Syntax: each array member is an expression document (https://www.mongodb.com/docs/manual/reference/operator/query/and/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$and": [{ "score": 1 }, 5] }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "$and element 1 is not a filter document (operation: find)" }
            ]
        },
        {
            "id": "op.not.top_level_rejected",
            "surface": "error",
            "source": "MongoDB manual, $not: \"$not performs a logical NOT operation on the specified <operator-expression>\" (a field-level operator) (https://www.mongodb.com/docs/manual/reference/operator/query/not/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "$not": { "score": { "$gt": 10 } } }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "equals": "unknown top level operator: $not (operation: find, fieldIndex: 0)" }
            ]
        },
        {
            "id": "op.in.scalar",
            "surface": "query",
            "source": "MongoDB manual, $in / Syntax (https://www.mongodb.com/docs/manual/reference/operator/query/in/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "score": 10 }, { "_id": 2, "score": 20 }, { "_id": 3, "score": 30 }] },
                { "op": "find", "collection": "items", "filter": { "score": { "$in": [10, 30] } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.in.array_any_element",
            "surface": "query",
            "source": "MongoDB manual, $in / Behavior: \"If field has an array, the $in operator selects the documents whose field has an array that contains at least one element that matches a value in the specified array\" (https://www.mongodb.com/docs/manual/reference/operator/query/in/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "tags": ["red", "blue"] }, { "_id": 2, "tags": ["green"] }, { "_id": 3, "tags": ["blue"] }] },
                { "op": "find", "collection": "items", "filter": { "tags": { "$in": ["blue"] } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.in.null_matches_missing_field",
            "surface": "query",
            "source": "oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-05, find {a: {$in: [null, 2]}} matched _id 2 (explicit null), 3 (missing), 4 ([null]) and 5 (2); {a: null} uses the same null predicate (https://www.mongodb.com/docs/manual/reference/operator/query/in/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": 1 }, { "_id": 2, "a": null }, { "_id": 3 }, { "_id": 4, "a": [null] }, { "_id": 5, "a": 2 }] },
                { "op": "find", "collection": "items", "filter": { "a": { "$in": [null, 2] } }, "sort": { "_id": 1 }, "as": "mixed" },
                { "op": "find", "collection": "items", "filter": { "a": { "$in": [null] } }, "sort": { "_id": 1 }, "as": "single" },
                { "op": "find", "collection": "items", "filter": { "a": { "$nin": [null] } }, "sort": { "_id": 1 }, "as": "nin" },
                { "op": "find", "collection": "items", "filter": { "a": { "$ne": null } }, "sort": { "_id": 1 }, "as": "ne" }
            ],
            "checks": [
                { "at": "/mixed/cursor/firstBatch/#", "equals": 4 },
                { "at": "/mixed/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "2" }, { "$numberInt": "3" }, { "$numberInt": "4" }, { "$numberInt": "5" }] },
                { "at": "/single/cursor/firstBatch/#", "equals": 3 },
                { "at": "/single/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "2" }, { "$numberInt": "3" }, { "$numberInt": "4" }] },
                { "at": "/nin/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "5" }] },
                { "at": "/ne/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "5" }] }
            ]
        },
        {
            "id": "op.in.empty_array_rejected",
            "surface": "error",
            "source": "No source: https://www.mongodb.com/docs/manual/reference/operator/query/in/ and .../nin/ do not define an empty operand array; the gateway refuses instead of guessing",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "score": { "$in": [] } }, "as": "in" },
                { "op": "find", "collection": "items", "filter": { "score": { "$nin": [] } }, "as": "nin" }
            ],
            "checks": [
                { "at": "/in/code", "equals": { "$numberInt": "2" } },
                { "at": "/in/errmsg", "equals": "$in with an empty array is not defined by the MongoDB manual; refusing to guess (operation: find, field: \"score\", fieldIndex: 0, operatorIndex: 0)" },
                { "at": "/nin/code", "equals": { "$numberInt": "2" } },
                { "at": "/nin/errmsg", "equals": "$nin with an empty array is not defined by the MongoDB manual; refusing to guess (operation: find, field: \"score\", fieldIndex: 0, operatorIndex: 0)" }
            ]
        },
        {
            "id": "op.nin.missing_field",
            "surface": "query",
            "source": "MongoDB manual, $nin / Behavior: \"$nin selects the documents where: the specified field value is not in the specified array or the specified field does not exist\" (https://www.mongodb.com/docs/manual/reference/operator/query/nin/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "color": "red" }, { "_id": 2, "color": "blue" }, { "_id": 3 }] },
                { "op": "find", "collection": "items", "filter": { "color": { "$nin": ["red"] } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "2" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.exists.missing_vs_present",
            "surface": "query",
            "source": "MongoDB manual, $exists / Behavior: \"$exists matches the documents that contain the field, including documents where the field value is null\" and \"$exists: false ... returns only those documents that do not contain the field\" (https://www.mongodb.com/docs/manual/reference/operator/query/exists/); oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-05, find {a: {$exists: false}} matched",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": null }, { "_id": 2, "a": 1 }, { "_id": 3 }] },
                { "op": "find", "collection": "items", "filter": { "a": { "$exists": true } }, "sort": { "_id": 1 }, "as": "yes" },
                { "op": "find", "collection": "items", "filter": { "a": { "$exists": false } }, "sort": { "_id": 1 }, "as": "no" }
            ],
            "checks": [
                { "at": "/yes/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "2" }] },
                { "at": "/no/cursor/firstBatch/#", "equals": 1 },
                { "at": "/no/cursor/firstBatch/0/_id", "equals": { "$numberInt": "3" } }
            ]
        },
        {
            "id": "op.null.matches_missing_and_explicit",
            "surface": "query",
            "source": "MongoDB manual, Query for Null or Missing Fields / Equality Filter: \"{ item: null } query matches documents that either contain the item field whose value is null or that do not contain the item field\" (https://www.mongodb.com/docs/manual/tutorial/query-for-null-fields/); oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-05, find {a: null} matched",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": null }, { "_id": 2, "a": 1 }, { "_id": 3 }] },
                { "op": "find", "collection": "items", "filter": { "a": null }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.null.array_with_null",
            "surface": "query",
            "source": "MongoDB manual, Query for Null or Missing Fields / $type: \"{ item: null } query matches ... an array that contains a null element\" (https://www.mongodb.com/docs/manual/tutorial/query-for-null-fields/); oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-05, find {a: null} on [null] matched and [] did not",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": [null, 1] }, { "_id": 2, "a": [] }, { "_id": 3, "a": 1 }] },
                { "op": "find", "collection": "items", "filter": { "a": null }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "1" } }
            ]
        },
        {
            "id": "op.ne.null_complement",
            "surface": "query",
            "source": "MongoDB manual, Query for Null or Missing Fields / $ne: \"{ item: { $ne: null } } ... matches documents where the item field contains a value that is not null or ... an empty array\" (https://www.mongodb.com/docs/manual/tutorial/query-for-null-fields/); oracle: mongod 8.0.9 standalone (--port 28017), 2026-11-05, find {a: {$ne: null}} matched",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": null }, { "_id": 2, "a": 1 }, { "_id": 3, "a": [] }, { "_id": 4 }] },
                { "op": "find", "collection": "items", "filter": { "a": { "$ne": null } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "2" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.type.null_explicit_only",
            "surface": "query",
            "source": "MongoDB manual, Query for Null or Missing Fields / $type: \"{ item : { $type: 10 } } query matches only documents that contain the item field whose value is null\" (https://www.mongodb.com/docs/manual/tutorial/query-for-null-fields/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "a": null }, { "_id": 2, "a": 1 }, { "_id": 3 }] },
                { "op": "find", "collection": "items", "filter": { "a": { "$type": 10 } }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberInt": "1" } }
            ]
        },
        {
            "id": "op.type.number_alias_array_element",
            "surface": "query",
            "source": "MongoDB manual, $type / Behavior: \"the query returns documents in which at least one array element matches a type passed to $type\" (https://www.mongodb.com/docs/manual/reference/operator/query/type/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": 1 }, { "_id": 2, "v": { "$numberLong": "1" } }, { "_id": 3, "v": "1" }, { "_id": 4, "v": ["x", 2] }] },
                { "op": "find", "collection": "items", "filter": { "v": { "$type": "number" } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 3 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "2" }, { "$numberInt": "4" }] }
            ]
        },
        {
            "id": "op.type.array_field",
            "surface": "query",
            "source": "MongoDB manual, $type / Behavior: \"Queries for $type: 'array' return documents where the field itself is an array\" (https://www.mongodb.com/docs/manual/reference/operator/query/type/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "tags": ["a"] }, { "_id": 2, "tags": "a" }, { "_id": 3, "tags": [] }] },
                { "op": "find", "collection": "items", "filter": { "tags": { "$type": "array" } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.type.array_operand",
            "surface": "query",
            "source": "MongoDB manual, $type / Syntax: the argument may be a single BSON type or an array of types (https://www.mongodb.com/docs/manual/reference/operator/query/type/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": 1 }, { "_id": 2, "v": { "$numberDouble": "1.5" } }, { "_id": 3, "v": { "$numberLong": "2" } }] },
                { "op": "find", "collection": "items", "filter": { "v": { "$type": ["int", "long"] } }, "sort": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "op.type.int_vs_double",
            "surface": "query",
            "source": "MongoDB manual, BSON Types: Double 1, int 16, long 18 (https://www.mongodb.com/docs/manual/reference/bson-types/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": 1 }, { "_id": 2, "v": { "$numberDouble": "1.5" } }, { "_id": 3, "v": { "$numberLong": "2" } }] },
                { "op": "find", "collection": "items", "filter": { "v": { "$type": 16 } }, "as": "int" },
                { "op": "find", "collection": "items", "filter": { "v": { "$type": "double" } }, "as": "double" }
            ],
            "checks": [
                { "at": "/int/cursor/firstBatch/#", "equals": 1 },
                { "at": "/int/cursor/firstBatch/0/_id", "equals": { "$numberInt": "1" } },
                { "at": "/double/cursor/firstBatch/0/_id", "equals": { "$numberInt": "2" } },
                { "at": "/double/cursor/firstBatch/0/v", "equals": { "$numberDouble": "1.5" } }
            ]
        },
        {
            "id": "op.type.unknown_alias_rejected",
            "surface": "error",
            "source": "MongoDB manual, $type / Behavior: the argument is a BSON type alias or code from the BSON Types table (https://www.mongodb.com/docs/manual/reference/bson-types/)",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "v": { "$type": "money" } }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/code", "equals": { "$numberInt": "2" } },
                { "at": "/r/errmsg", "matches": "unknown \\$type alias: money" }
            ]
        },
        {
            "id": "op.size.array_and_non_array",
            "surface": "query",
            "source": "MongoDB manual, $size / Behavior: \"The $size operator matches any array with the number of elements specified by the argument\" (https://www.mongodb.com/docs/manual/reference/operator/query/size/)",
