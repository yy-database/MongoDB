{
    "version": 1,
    "cases": [
        {
            "id": "persist.reopen.keeps_documents",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": "a" }, { "_id": 2, "v": "b" }], "as": "r1" },
                { "op": "reopen", "store": "s" },
                { "op": "find", "collection": "items", "filter": {}, "sort": { "_id": 1 }, "as": "r2" }
            ],
            "checks": [
                { "at": "/r1/n", "equals": { "$numberInt": "2" } },
                { "at": "/r2/cursor/firstBatch/#", "equals": 2 },
                { "at": "/r2/cursor/firstBatch/*/v", "equals": ["a", "b"] },
                { "at": "/r2/cursor/ns", "equals": "app.items" }
            ]
        },
        {
            "id": "persist.reopen.keeps_collections",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }], "as": "r1" },
                { "op": "insert", "collection": "others", "documents": [{ "_id": 1 }], "as": "r2" },
                { "op": "reopen", "store": "s" },
                { "op": "listCollections", "as": "r3" }
            ],
            "checks": [{ "at": "/r3/cursor/firstBatch/#", "equals": 2 }]
        },
        {
            "id": "persist.reopen.after_delete",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }, { "_id": 2 }, { "_id": 3 }], "as": "r1" },
                { "op": "delete", "collection": "items", "deletes": [{ "q": { "_id": 2 }, "limit": 1 }], "as": "r2" },
                { "op": "reopen", "store": "s" },
                { "op": "count", "collection": "items", "query": {}, "as": "r3" },
                { "op": "find", "collection": "items", "filter": {}, "sort": { "_id": 1 }, "as": "r4" }
            ],
            "checks": [
                { "at": "/r2/n", "equals": { "$numberInt": "1" } },
                { "at": "/r3/n", "equals": { "$numberInt": "2" } },
                { "at": "/r4/cursor/firstBatch/*/_id", "equals": [{ "$numberInt": "1" }, { "$numberInt": "3" }] }
            ]
        },
        {
            "id": "persist.reopen.namespace_isolation",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }, { "_id": 2 }], "db": "app", "as": "r1" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }], "db": "other", "as": "r2" },
                { "op": "reopen", "store": "s" },
                { "op": "count", "collection": "items", "query": {}, "db": "app", "as": "r3" },
                { "op": "count", "collection": "items", "query": {}, "db": "other", "as": "r4" }
            ],
            "checks": [
                { "at": "/r3/n", "equals": { "$numberInt": "2" } },
                { "at": "/r4/n", "equals": { "$numberInt": "1" } }
            ]
        },
        {
            "id": "persist.reopen.after_import",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                {
                    "op": "importBson",
                    "namespace": "app.items",
                    "hex": "1f000000075f69640000000000000000000000000102760002000000610000",
                    "as": "r1"
                },
                { "op": "reopen", "store": "s" },
                { "op": "count", "collection": "items", "query": {}, "as": "r2" },
                { "op": "find", "collection": "items", "filter": {}, "as": "r3" }
            ],
            "checks": [
                { "at": "/r1", "equals": 1 },
                { "at": "/r2/n", "equals": { "$numberInt": "1" } },
                { "at": "/r3/cursor/firstBatch/0/v", "equals": "a" },
                { "at": "/r3/cursor/firstBatch/0/_id", "equals": { "$oid": "000000000000000000000001" } }
            ]
        },
        {
            "id": "persist.import.file_and_reopen",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                {
                    "op": "importBsonFile",
                    "namespace": "app.items",
                    "file": "dump",
                    "hex": "1f000000075f69640000000000000000000000000202760002000000610000",
                    "as": "r1"
                },
                { "op": "reopen", "store": "s" },
                { "op": "find", "collection": "items", "filter": {}, "as": "r2" }
            ],
            "checks": [
                { "at": "/r1", "equals": 1 },
                { "at": "/r2/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r2/cursor/firstBatch/0/_id", "equals": { "$oid": "000000000000000000000002" } }
            ]
        },
        {
            "id": "persist.import.replaces_existing",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": { "$oid": "000000000000000000000001" }, "v": "first" }], "as": "r1" },
                {
                    "op": "importBson",
                    "namespace": "app.items",
                    "hex": "24000000075f696400000000000000000000000001027600070000007365636f6e640000",
                    "as": "r2"
                },
                { "op": "find", "collection": "items", "filter": {}, "as": "r3" },
                { "op": "count", "collection": "items", "query": {}, "as": "r4" }
            ],
            "checks": [
                { "at": "/r2", "equals": 1 },
                { "at": "/r3/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r3/cursor/firstBatch/0/v", "equals": "second" },
                { "at": "/r4/n", "equals": { "$numberInt": "1" } }
            ]
        },
        {
            "id": "persist.empty_store",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "find", "collection": "items", "filter": {}, "as": "r1" },
                { "op": "listCollections", "as": "r2" },
                { "op": "listDatabases", "as": "r3" }
            ],
            "checks": [
                { "at": "/r1/cursor/firstBatch/#", "equals": 0 },
                { "at": "/r1/ok", "equals": { "$numberDouble": "1.0" } },
                { "at": "/r2/cursor/firstBatch/#", "equals": 0 },
                { "at": "/r3/databases/#", "equals": 0 }
            ]
        },
        {
            "id": "persist.file_layout",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }], "as": "r1" },
                { "op": "dataFiles", "as": "r2" },
                { "op": "fileSize", "as": "r3" }
            ],
            "checks": [
                { "at": "/r2", "equals": ["s.yyds", "s.yykv"] },
                { "at": "/r3", "gte": 1 },
                { "at": "/r2/#", "equals": 2 }
            ]
        },
        {
            "id": "persist.file_grows_with_many_records",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "synthetic": { "kind": "series", "count": 100, "offset": 0 }, "as": "r1" },
                { "op": "dataFiles", "as": "r2" },
                { "op": "fileSize", "as": "r3" },
                { "op": "count", "collection": "items", "query": {}, "as": "r4" }
            ],
            "checks": [
                { "at": "/r1/n", "equals": { "$numberInt": "100" } },
                { "at": "/r2/#", "equals": 2 },
                { "at": "/r3", "gte": 100 },
                { "at": "/r4/n", "equals": { "$numberInt": "100" } }
            ]
        },
        {
            "id": "persist.corrupt_import_then_readable",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "importBson", "namespace": "app.items", "hex": "05000000", "as": "r1" },
                { "op": "count", "collection": "items", "query": {}, "as": "r2" },
                { "op": "listCollections", "as": "r3" }
            ],
            "checks": [
                { "at": "/r1", "throws": true },
                { "at": "/r2/n", "equals": { "$numberInt": "0" } },
                { "at": "/r3/cursor/firstBatch/#", "equals": 0 }
            ]
        },
        {
            "id": "persist.import_bad_namespace_then_readable",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "importBson", "namespace": "items", "hex": "0500000000", "as": "r1" },
                { "op": "listCollections", "as": "r2" }
            ],
            "checks": [
                { "at": "/r1", "throws": true },
                { "at": "/r2/cursor/firstBatch/#", "equals": 0 }
            ]
        },
        {
            "id": "persist.reopen.twice",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "v": "x" }], "as": "r1" },
                { "op": "reopen", "store": "s" },
                { "op": "reopen", "store": "s" },
                { "op": "count", "collection": "items", "query": {}, "as": "r2" }
            ],
            "checks": [{ "at": "/r2/n", "equals": { "$numberInt": "1" } }]
        },
        {
            "id": "persist.binary_subtype_survives_reopen",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "legacy": { "$binary": { "base64": "AQID", "subType": "02" } } }] },
                { "op": "reopen", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "_id": 1 }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/0/legacy", "equals": { "$binary": { "base64": "AQID", "subType": "02" } } }
            ]
        },
        {
            "id": "persist.numeric_id_survives_reopen",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": { "$numberLong": "1" }, "v": "x" }] },
                { "op": "reopen", "store": "s" },
                { "op": "find", "collection": "items", "filter": { "_id": { "$numberDouble": "1.0" } }, "as": "r" }
            ],
            "checks": [
                { "at": "/r/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r/cursor/firstBatch/0/_id", "equals": { "$numberLong": "1" } }
            ]
        },
        {
            "id": "persist.oplog.commit_positions",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "enableOplog", "store": "s", "namespace": "local.oplog.rs", "maxBytes": 1048576 },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1, "n": "a" }, { "_id": 2, "n": "b" }], "as": "r1" },
                { "op": "commitOplog", "store": "s", "wallMillis": 1000, "as": "r2" },
                { "op": "commitOplog", "store": "s", "wallMillis": 1001, "as": "r3" },
                { "op": "find", "collection": "oplog.rs", "db": "local", "filter": {}, "as": "r4" },
                { "op": "update", "collection": "items", "updates": [{ "q": { "_id": 1 }, "u": { "$set": { "n": "c" } } }], "as": "r5" },
                { "op": "commitOplog", "store": "s", "wallMillis": 1002, "as": "r6" },
                { "op": "delete", "collection": "items", "deletes": [{ "q": { "_id": 2 }, "limit": 1 }], "as": "r7" },
                { "op": "commitOplog", "store": "s", "wallMillis": 1003, "as": "r8" }
            ],
            "checks": [
                { "at": "/r2/t", "equals": 1 },
                { "at": "/r2/i", "equals": 1 },
                { "at": "/r3", "equals": null },
                { "at": "/r4/cursor/firstBatch/#", "equals": 1 },
                { "at": "/r4/cursor/firstBatch/0/ns", "equals": "admin.$cmd" },
                { "at": "/r4/cursor/firstBatch/0/op", "equals": "c" },
                { "at": "/r4/cursor/firstBatch/0/t", "equals": { "$numberLong": "1" } },
                { "at": "/r4/cursor/firstBatch/0/wall", "equals": { "$date": { "$numberLong": "1000" } } },
                { "at": "/r4/cursor/firstBatch/0/o/applyOps/#", "equals": 2 },
                { "at": "/r4/cursor/firstBatch/0/o/applyOps/0/ns", "equals": "app.items" },
                { "at": "/r4/cursor/firstBatch/0/o/applyOps/0/op", "equals": "i" },
                { "at": "/r4/cursor/firstBatch/0/o/applyOps/0/o", "equals": { "_id": { "$numberInt": "1" }, "n": "a" } },
                { "at": "/r6/t", "equals": 1 },
                { "at": "/r6/i", "equals": 2 },
                { "at": "/r8/t", "equals": 1 },
                { "at": "/r8/i", "equals": 3 }
            ]
        },
        {
            "id": "persist.oplog.discard_drops_the_buffer",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "enableOplog", "store": "s", "namespace": "local.oplog.rs", "maxBytes": 1048576 },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }], "as": "r1" },
                { "op": "discardOplog", "store": "s", "as": "r2" },
                { "op": "commitOplog", "store": "s", "wallMillis": 2000, "as": "r3" },
                { "op": "find", "collection": "oplog.rs", "db": "local", "filter": {}, "as": "r4" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 2 }], "as": "r5" },
                { "op": "commitOplog", "store": "s", "wallMillis": 2001, "as": "r6" },
                { "op": "commitOplog", "store": "s", "wallMillis": 2002, "as": "r7" }
            ],
            "checks": [
                { "at": "/r2", "equals": null },
                { "at": "/r3", "equals": null },
                { "at": "/r4/cursor/firstBatch/#", "equals": 0 },
                { "at": "/r6/t", "equals": 2 },
                { "at": "/r6/i", "equals": 1 },
                { "at": "/r7", "equals": null }
            ]
        },
        {
            "id": "persist.oplog.disabled_store_keeps_no_entries",
            "surface": "persistence",
            "program": [
                { "op": "open", "store": "s" },
                { "op": "insert", "collection": "items", "documents": [{ "_id": 1 }], "as": "r1" },
                { "op": "commitOplog", "store": "s", "wallMillis": 3000, "as": "r2" },
                { "op": "find", "collection": "oplog.rs", "db": "local", "filter": {}, "as": "r3" }
            ],
            "checks": [
                { "at": "/r2", "equals": null },
                { "at": "/r3/cursor/firstBatch/#", "equals": 0 }
            ]
        }
    ]
}
